NODE_ENV=development
PORT=5000

API_VERSION=v1
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_disaster_db
DB_USER=root
DB_PASSWORD=root123
DB_DIALECT=mysql
DB_LOGGING=false

JWT_SECRET=replace_with_secure_long_random_secret
JWT_EXPIRES_IN=7d

OPENWEATHER_API_KEY=replace_with_openweather_key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_app_password
MAIL_FROM="Smart Disaster Relief <no-reply@disaster.local>"

TWILIO_ACCOUNT_SID=replace_with_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_token
TWILIO_PHONE_NUMBER=+10000000000
